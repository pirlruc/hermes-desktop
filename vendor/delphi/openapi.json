                "default": [],
                "items": {
                  "type": "string"
                },
                "title": "Authors",
                "type": "array"
              },
              "keywords": {
                "default": [],
                "items": {
                  "type": "string"
                },
                "title": "Keywords",
                "type": "array"
              },
              "abstract": {
                "default": "",
                "title": "Abstract",
                "type": "string"
              },
              "claims": {
                "default": [],
                "items": {
                  "type": "string"
                },
                "title": "Claims",
                "type": "array"
              },
              "published_on": {
                "format": "date",
                "title": "Published On",
                "type": "string"
              },
              "identities": {
                "default": [],
                "items": {
                  "$ref": "#/$defs/Identity"
                },
                "title": "Identities",
                "type": "array"
              },
              "categories": {
                "default": [],
                "items": {
                  "$ref": "#/$defs/Category"
                },
                "title": "Categories",
                "type": "array"
              }
            },
            "required": [
              "id",
              "kind",
              "title",
              "published_on"
            ],
            "title": "Work",
            "type": "object"
          },
          "WorkKind": {
            "description": "Catalog node type.",
            "enum": [
              "paper",
              "patent"
            ],
            "title": "WorkKind",
            "type": "string"
          }
        },
        "description": "Citation and/or content neighbors of a seed work.\n\nAttributes:\n    seed: Center work.\n    mode: Requested graph mode.\n    neighbors: Tagged neighbor rows.",
        "properties": {
          "seed": {
            "$ref": "#/$defs/Work"
          },
          "mode": {
            "$ref": "#/$defs/NeighborhoodMode"
          },
          "neighbors": {
            "default": [],
            "items": {
              "$ref": "#/$defs/Neighbor"
            },
            "title": "Neighbors",
            "type": "array"
          }
        },
        "required": [
          "seed",
          "mode"
        ],
        "title": "Neighborhood",
        "type": "object"
      },
      "PathRequest": {
        "$defs": {
          "PathKind": {
            "description": "Generator output kind.",
            "enum": [
              "research_path",
              "patent_whitespace"
            ],
            "title": "PathKind",
            "type": "string"
          }
        },
        "description": "Generate a research path or patent whitespace.\n\nAttributes:\n    kind: research_path or patent_whitespace.\n    subcategory: Required SYS-009 filter.\n    seed_work_id: Catalog work to expand from.\n    extraction_id: Uploaded extraction to expand from when not yet a work.\n    as_of: Optional temporal bound (inclusive).",
        "properties": {
          "kind": {
            "$ref": "#/$defs/PathKind"
          },
          "subcategory": {
            "minLength": 1,
            "title": "Subcategory",
            "type": "string"
          },
          "seed_work_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Seed Work Id"
          },
          "extraction_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Extraction Id"
          },
          "as_of": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "As Of"
          }
        },
        "required": [
          "kind",
          "subcategory"
        ],
        "title": "PathRequest",
        "type": "object"
      },
      "PathProposal": {
        "$defs": {
          "PathKind": {
            "description": "Generator output kind.",
            "enum": [
              "research_path",
              "patent_whitespace"
            ],
            "title": "PathKind",
            "type": "string"
          }
        },
        "description": "One structured generator output.\n\nAttributes:\n    kind: Same kind as the request.\n    title: Short proposal title.\n    claims: Concrete next-step claims.\n    rationale: Why the neighborhood supports this.\n    cited_work_ids: Context work ids the proposal may cite.\n    rank: 1 is best.",
        "properties": {
          "kind": {
            "$ref": "#/$defs/PathKind"
          },
          "title": {
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "claims": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Claims",
            "type": "array"
          },
          "rationale": {
            "minLength": 1,
            "title": "Rationale",
            "type": "string"
          },
          "cited_work_ids": {
            "default": [],
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "title": "Cited Work Ids",
            "type": "array"
          },
          "rank": {
            "minimum": 1,
            "title": "Rank",
            "type": "integer"
          }
        },
        "required": [
          "kind",
          "title",
          "claims",
          "rationale",
          "rank"
        ],
        "title": "PathProposal",
        "type": "object"
      },
      "EvalRun": {
        "$defs": {
          "EvalScores": {
            "description": "Judge and embedding scores for one proposal vs held-out work.\n\nAttributes:\n    novelty: Judge novelty 1-5.\n    relevance: Judge relevance 1-5.\n    accuracy: Judge accuracy 1-5.\n    embedding_similarity: Cosine similarity vs held-out text.",
            "properties": {
              "novelty": {
                "maximum": 5.0,
                "minimum": 1.0,
                "title": "Novelty",
                "type": "number"
              },
              "relevance": {
                "maximum": 5.0,
                "minimum": 1.0,
                "title": "Relevance",
                "type": "number"
              },
              "accuracy": {
                "maximum": 5.0,
                "minimum": 1.0,
                "title": "Accuracy",
                "type": "number"
              },
              "embedding_similarity": {
                "maximum": 1.0,
                "minimum": 0.0,
                "title": "Embedding Similarity",
                "type": "number"
              }
            },
            "required": [
              "novelty",
              "relevance",
              "accuracy",
              "embedding_similarity"
            ],
            "title": "EvalScores",
            "type": "object"
          },
          "PathKind": {
            "description": "Generator output kind.",
            "enum": [
              "research_path",
              "patent_whitespace"
            ],
            "title": "PathKind",
            "type": "string"
          },
          "ProviderKind": {
            "description": "SYS-006 LLM adapter selection.",
            "enum": [
              "cloud",
              "local",
              "fake"
            ],
            "title": "ProviderKind",
            "type": "string"
          }
        },
        "description": "One hindcast trial record.\n\nAttributes:\n    id: Run UUID.\n    held_out_id: Hidden work.\n    seed_id: Seed used for generation.\n    kind: Query kind.\n    subcategory: Filter used.\n    provider: SYS-006 adapter that ran.\n    model_id: Model identifier recorded for the run.\n    scores: Aggregated scores.\n    created_at: UTC timestamp.",
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "held_out_id": {
            "format": "uuid",
            "title": "Held Out Id",
            "type": "string"
          },
          "seed_id": {
            "format": "uuid",
            "title": "Seed Id",
            "type": "string"
          },
          "kind": {
            "$ref": "#/$defs/PathKind"
          },
          "subcategory": {
            "title": "Subcategory",
            "type": "string"
          },
          "provider": {
            "$ref": "#/$defs/ProviderKind"
          },
          "model_id": {
            "title": "Model Id",
            "type": "string"
          },
          "scores": {
            "$ref": "#/$defs/EvalScores"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "held_out_id",
          "seed_id",
          "kind",
          "subcategory",
          "provider",
          "model_id",
          "scores"
        ],
        "title": "EvalRun",
        "type": "object"
      }
    }
  }
}
