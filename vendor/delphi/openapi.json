          },
          "CategoryScheme": {
            "description": "Taxonomy a category code belongs to.",
            "enum": [
              "openalex_topic",
              "cpc"
            ],
            "title": "CategoryScheme",
            "type": "string"
          },
          "EdgeKind": {
            "description": "Stored graph edge kind.",
            "enum": [
              "cites",
              "similar_to"
            ],
            "title": "EdgeKind",
            "type": "string"
          },
          "Identity": {
            "description": "One external identifier for a work.\n\nAttributes:\n    kind: Identifier scheme.\n    value: Scheme-specific value (DOI, arXiv id, OpenAlex id, patent number, hash).",
            "properties": {
              "kind": {
                "$ref": "#/$defs/IdentityKind"
              },
              "value": {
                "minLength": 1,
                "title": "Value",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "value"
            ],
            "title": "Identity",
            "type": "object"
          },
          "IdentityKind": {
            "description": "External identifier scheme for a work.",
            "enum": [
              "doi",
              "arxiv",
              "openalex",
              "patent",
              "content_hash"
            ],
            "title": "IdentityKind",
            "type": "string"
          },
          "Neighbor": {
            "description": "One dated neighbor tagged by edge kind.\n\nAttributes:\n    work: Neighbor catalog record.\n    edge_kind: cites or similar_to.\n    direction: in or out relative to the seed.\n    score: Similarity score when edge_kind is similar_to.",
            "properties": {
              "work": {
                "$ref": "#/$defs/Work"
              },
              "edge_kind": {
                "$ref": "#/$defs/EdgeKind"
              },
              "direction": {
                "$ref": "#/$defs/NeighborDirection"
              },
              "score": {
                "anyOf": [
                  {
                    "maximum": 1.0,
                    "minimum": 0.0,
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Score"
              }
            },
            "required": [
              "work",
              "edge_kind",
              "direction"
            ],
            "title": "Neighbor",
            "type": "object"
          },
          "NeighborDirection": {
            "description": "Edge direction relative to the seed work.",
            "enum": [
              "in",
              "out"
            ],
            "title": "NeighborDirection",
            "type": "string"
          },
          "NeighborhoodMode": {
            "description": "Which graph a neighborhood query walks.",
            "enum": [
              "citation",
              "content",
              "union"
            ],
            "title": "NeighborhoodMode",
            "type": "string"
          },
          "SubcategoryId": {
            "description": "Prototype subcategory filters (SYS-009).",
            "enum": [
              "transformers_foundation_models",
              "computer_vision",
              "steganography",
              "two_d_codes"
            ],
            "title": "SubcategoryId",
            "type": "string"
          },
          "Work": {
            "description": "A paper or patent in the catalog.\n\nAttributes:\n    id: Stable internal UUID.\n    kind: Paper or patent.\n    title: Display title.\n    authors: Ordered author or inventor names.\n    keywords: Subject tokens when known (CPC/IPC for patents).\n    abstract: Catalog abstract; may be empty for sparse records.\n    claims: Independent or representative claim text when the source provides it.\n    published_on: Publication or grant date used for hindcasting.\n    identities: External identifiers.\n    categories: Taxonomy assignments including subcategory.",
            "properties": {
              "id": {
