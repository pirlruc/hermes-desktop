{
  "openapi": "3.1.0",
  "info": {
    "title": "Delphi Engine",
    "version": "0.1.0",
    "description": "Prototype REST API owned by the contracts package."
  },
  "paths": {
    "/v1/works:batch-check": {
      "post": {
        "operationId": "batchCheckWorks",
        "summary": "Exact-identifier existence check",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Known/unknown rows"
          }
        }
      }
    },
    "/v1/works/{work_id}/neighborhood": {
      "get": {
        "operationId": "getNeighborhood",
        "summary": "Citation, content, or union neighborhood",
        "parameters": [
          {
            "name": "work_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "mode",
            "in": "query",
            "required": true,
            "schema": {
              "enum": [
                "citation",
                "content",
                "union"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Dated neighbors tagged by edge kind"
          }
        }
      }
    },
    "/v1/uploads": {
      "post": {
        "operationId": "uploadPdf",
        "summary": "Consented PDF upload",
        "responses": {
          "200": {
            "description": "Extraction plus attached graphs"
          }
        }
      }
    },
    "/v1/generate": {
      "post": {
        "operationId": "generatePath",
        "summary": "Research path or patent whitespace from a masked neighborhood",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ranked proposals"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Work": {
        "$defs": {
          "Category": {
            "description": "One taxonomy node used as a generate/neighborhood filter.\n\nAttributes:\n    scheme: openalex_topic or cpc.\n    code: Scheme-native code.\n    label: Human-readable name.\n    subcategory: Prototype subcategory id when this node maps onto SYS-009.\n    parent_code: Optional parent code in the same scheme.",
            "properties": {
              "scheme": {
                "$ref": "#/$defs/CategoryScheme"
              },
              "code": {
                "minLength": 1,
                "title": "Code",
                "type": "string"
              },
              "label": {
                "minLength": 1,
                "title": "Label",
                "type": "string"
              },
              "subcategory": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/SubcategoryId"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "parent_code": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Parent Code"
              }
            },
            "required": [
              "scheme",
              "code",
              "label"
            ],
            "title": "Category",
            "type": "object"
          },
          "CategoryScheme": {
            "description": "Taxonomy a category code belongs to.",
            "enum": [
              "openalex_topic",
              "cpc"
            ],
            "title": "CategoryScheme",
            "type": "string"
          },
          "Identity": {
            "description": "One external identifier for a work.\n\nAttributes:\n    kind: Identifier scheme.\n    value: Scheme-specific value (DOI, arXiv id, OpenAlex id, patent number, hash).",
            "properties": {
              "kind": {
                "$ref": "#/$defs/IdentityKind"
              },
              "value": {
                "minLength": 1,
                "title": "Value",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "value"
            ],
            "title": "Identity",
            "type": "object"
          },
          "IdentityKind": {
            "description": "External identifier scheme for a work.",
            "enum": [
              "doi",
              "arxiv",
              "openalex",
              "patent",
              "content_hash"
            ],
            "title": "IdentityKind",
            "type": "string"
          },
          "SubcategoryId": {
            "description": "Prototype subcategory filters (SYS-009).",
            "enum": [
              "transformers_foundation_models",
              "computer_vision",
              "steganography",
              "two_d_codes"
            ],
            "title": "SubcategoryId",
            "type": "string"
          },
          "WorkKind": {
            "description": "Catalog node type.",
            "enum": [
              "paper",
              "patent"
            ],
            "title": "WorkKind",
            "type": "string"
          }
        },
        "description": "A paper or patent in the catalog.\n\nAttributes:\n    id: Stable internal UUID.\n    kind: Paper or patent.\n    title: Display title.\n    authors: Ordered author or inventor names.\n    keywords: Subject tokens when known (CPC/IPC for patents).\n    abstract: Catalog abstract; may be empty for sparse records.\n    claims: Independent or representative claim text when the source provides it.\n    published_on: Publication or grant date used for hindcasting.\n    identities: External identifiers.\n    categories: Taxonomy assignments including subcategory.",
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "$ref": "#/$defs/WorkKind"
          },
          "title": {
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "authors": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Authors",
            "type": "array"
          },
          "keywords": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Keywords",
            "type": "array"
          },
          "abstract": {
            "default": "",
            "title": "Abstract",
            "type": "string"
          },
          "claims": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Claims",
            "type": "array"
          },
          "published_on": {
            "format": "date",
            "title": "Published On",
            "type": "string"
          },
          "identities": {
            "default": [],
            "items": {
              "$ref": "#/$defs/Identity"
            },
            "title": "Identities",
            "type": "array"
          },
          "categories": {
            "default": [],
            "items": {
              "$ref": "#/$defs/Category"
            },
            "title": "Categories",
            "type": "array"
          }
        },
        "required": [
          "id",
          "kind",
          "title",
          "published_on"
        ],
        "title": "Work",
        "type": "object"
      },
      "BatchCheckRequest": {
        "$defs": {
          "Identity": {
            "description": "One external identifier for a work.\n\nAttributes:\n    kind: Identifier scheme.\n    value: Scheme-specific value (DOI, arXiv id, OpenAlex id, patent number, hash).",
            "properties": {
              "kind": {
                "$ref": "#/$defs/IdentityKind"
              },
              "value": {
                "minLength": 1,
                "title": "Value",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "value"
            ],
            "title": "Identity",
            "type": "object"
          },
          "IdentityKind": {
            "description": "External identifier scheme for a work.",
            "enum": [
              "doi",
              "arxiv",
              "openalex",
              "patent",
              "content_hash"
            ],
            "title": "IdentityKind",
            "type": "string"
          }
        },
        "description": "Identifiers to resolve without uploading a PDF.\n\nAttributes:\n    identities: Rows to look up. Order is preserved in the response.",
        "properties": {
          "identities": {
            "items": {
              "$ref": "#/$defs/Identity"
            },
            "minItems": 1,
            "title": "Identities",
            "type": "array"
          }
        },
        "required": [
          "identities"
        ],
        "title": "BatchCheckRequest",
        "type": "object"
      },
      "BatchCheckResponse": {
        "$defs": {
          "BatchCheckRow": {
            "description": "Known/unknown result for one identity.\n\nAttributes:\n    identity: The queried identifier.\n    known: True when the catalog has an exact match.\n    work_id: Catalog UUID when known.",
            "properties": {
              "identity": {
                "$ref": "#/$defs/Identity"
              },
              "known": {
                "title": "Known",
                "type": "boolean"
              },
              "work_id": {
                "anyOf": [
                  {
                    "format": "uuid",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Work Id"
              }
            },
            "required": [
              "identity",
              "known"
            ],
            "title": "BatchCheckRow",
            "type": "object"
          },
          "Identity": {
            "description": "One external identifier for a work.\n\nAttributes:\n    kind: Identifier scheme.\n    value: Scheme-specific value (DOI, arXiv id, OpenAlex id, patent number, hash).",
            "properties": {
              "kind": {
                "$ref": "#/$defs/IdentityKind"
              },
              "value": {
                "minLength": 1,
                "title": "Value",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "value"
            ],
            "title": "Identity",
            "type": "object"
          },
          "IdentityKind": {
            "description": "External identifier scheme for a work.",
            "enum": [
              "doi",
              "arxiv",
              "openalex",
              "patent",
              "content_hash"
            ],
            "title": "IdentityKind",
            "type": "string"
          }
        },
        "description": "Batch-check results in request order.\n\nAttributes:\n    rows: One row per request identity.",
        "properties": {
          "rows": {
            "items": {
              "$ref": "#/$defs/BatchCheckRow"
            },
            "title": "Rows",
            "type": "array"
          }
        },
        "required": [
          "rows"
        ],
        "title": "BatchCheckResponse",
        "type": "object"
      },
      "PdfUpload": {
        "description": "Consent metadata that must accompany PDF bytes.\n\nAttributes:\n    consent_destination: Must name delphi as the destination.\n    filename: Original filename for logs.\n    content_hash: SHA-256 hex of the PDF bytes.",
        "properties": {
          "consent_destination": {
            "minLength": 1,
            "title": "Consent Destination",
            "type": "string"
          },
          "filename": {
            "minLength": 1,
            "title": "Filename",
            "type": "string"
          },
          "content_hash": {
            "maxLength": 64,
            "minLength": 32,
            "title": "Content Hash",
            "type": "string"
          }
        },
        "required": [
          "consent_destination",
          "filename",
          "content_hash"
        ],
        "title": "PdfUpload",
        "type": "object"
      },
      "Extraction": {
        "$defs": {
          "BibliographyEntry": {
            "description": "One extracted citation, possibly unresolved.\n\nAttributes:\n    raw: Bibliography string as extracted.\n    identity: Parsed identifier when present.\n    title: Parsed title when present.\n    year: Parsed year when present.\n    matched_work_id: Catalog work when batch-check resolves the cite.",
            "properties": {
              "raw": {
                "minLength": 1,
                "title": "Raw",
                "type": "string"
              },
              "identity": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Identity"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "title": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Title"
              },
              "year": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Year"
              },
              "matched_work_id": {
                "anyOf": [
                  {
                    "format": "uuid",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Matched Work Id"
              }
            },
            "required": [
              "raw"
            ],
            "title": "BibliographyEntry",
            "type": "object"
          },
          "Category": {
            "description": "One taxonomy node used as a generate/neighborhood filter.\n\nAttributes:\n    scheme: openalex_topic or cpc.\n    code: Scheme-native code.\n    label: Human-readable name.\n    subcategory: Prototype subcategory id when this node maps onto SYS-009.\n    parent_code: Optional parent code in the same scheme.",
            "properties": {
              "scheme": {
                "$ref": "#/$defs/CategoryScheme"
              },
              "code": {
                "minLength": 1,
                "title": "Code",
                "type": "string"
              },
              "label": {
                "minLength": 1,
                "title": "Label",
                "type": "string"
              },
              "subcategory": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/SubcategoryId"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "parent_code": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Parent Code"
              }
            },
            "required": [
              "scheme",
              "code",
              "label"
            ],
            "title": "Category",
            "type": "object"
          },
          "CategoryScheme": {
            "description": "Taxonomy a category code belongs to.",
            "enum": [
              "openalex_topic",
              "cpc"
            ],
            "title": "CategoryScheme",
            "type": "string"
          },
          "Identity": {
            "description": "One external identifier for a work.\n\nAttributes:\n    kind: Identifier scheme.\n    value: Scheme-specific value (DOI, arXiv id, OpenAlex id, patent number, hash).",
            "properties": {
              "kind": {
                "$ref": "#/$defs/IdentityKind"
              },
              "value": {
                "minLength": 1,
                "title": "Value",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "value"
            ],
            "title": "Identity",
            "type": "object"
          },
          "IdentityKind": {
            "description": "External identifier scheme for a work.",
            "enum": [
              "doi",
              "arxiv",
              "openalex",
              "patent",
              "content_hash"
            ],
            "title": "IdentityKind",
            "type": "string"
          },
          "SubcategoryId": {
            "description": "Prototype subcategory filters (SYS-009).",
            "enum": [
              "transformers_foundation_models",
              "computer_vision",
              "steganography",
              "two_d_codes"
            ],
            "title": "SubcategoryId",
            "type": "string"
          }
        },
        "description": "Structured fields taken from a consented PDF.\n\nAttributes:\n    id: Extraction UUID (often the work id after upsert).\n    content_hash: SHA-256 of source bytes.\n    title: Extracted title.\n    authors: Extracted authors.\n    keywords: Extracted keywords.\n    published_on: Extracted date when present.\n    identities: Extracted identifiers.\n    bibliography: Parsed bibliography rows.\n    body_text: Extracted body used for the content graph.\n    suggested_categories: LLM-suggested filters; user may override.",
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "content_hash": {
            "minLength": 32,
            "title": "Content Hash",
            "type": "string"
          },
          "title": {
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "authors": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Authors",
            "type": "array"
          },
          "keywords": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Keywords",
            "type": "array"
          },
          "published_on": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Published On"
          },
          "identities": {
            "default": [],
            "items": {
              "$ref": "#/$defs/Identity"
            },
            "title": "Identities",
            "type": "array"
          },
          "bibliography": {
            "default": [],
            "items": {
              "$ref": "#/$defs/BibliographyEntry"
            },
            "title": "Bibliography",
            "type": "array"
          },
          "body_text": {
            "default": "",
            "title": "Body Text",
            "type": "string"
          },
          "suggested_categories": {
            "default": [],
            "items": {
              "$ref": "#/$defs/Category"
            },
            "title": "Suggested Categories",
            "type": "array"
          }
        },
        "required": [
          "id",
          "content_hash",
          "title"
        ],
        "title": "Extraction",
        "type": "object"
      },
      "Neighborhood": {
        "$defs": {
          "Category": {
            "description": "One taxonomy node used as a generate/neighborhood filter.\n\nAttributes:\n    scheme: openalex_topic or cpc.\n    code: Scheme-native code.\n    label: Human-readable name.\n    subcategory: Prototype subcategory id when this node maps onto SYS-009.\n    parent_code: Optional parent code in the same scheme.",
            "properties": {
              "scheme": {
                "$ref": "#/$defs/CategoryScheme"
              },
              "code": {
                "minLength": 1,
                "title": "Code",
                "type": "string"
